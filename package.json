{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit \u2014 Personal Capital Operating System",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/assets/dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:sql": "node scripts/apply-sql.mjs",
    "db:verify": "node scripts/verify-invariants.mjs",
    "db:studio": "prisma studio",
    "size": "size-limit",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm check:contrast && pnpm test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "gallery": "node scripts/capture-gallery.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "db:verify-rls": "node scripts/verify-rls.mjs",
    "db:release": "pnpm db:deploy && pnpm db:sql && pnpm db:verify",
    "db:provision": "node scripts/provision.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "idb": "^8.0.2",
    "lucide-react": "^0.545.0",
    "motion": "^12.4.7",
    "next": "^15.5.0",
    "next-themes": "^0.4.4",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.50.1",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.0.5",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^7.9.1",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "size-limit": [
    {
      "name": "initial JS (PRD P-05)",
      "path": ".next/static/chunks/*.js",
      "limit": "180 kB"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
