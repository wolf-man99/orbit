# Orbit — environment template. Copy to .env.local and fill in.
# Never commit .env.local.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection. MUST authenticate as `orbit_app` — a non-owner role with
# no BYPASSRLS. Connecting as the owner (`postgres`) silently disables every
# row-level security policy. See prisma/sql/002_rls.sql.
DATABASE_URL="postgresql://orbit_app:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Unpooled, owner-role connection used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Optional: separate database for migration shadowing.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="orbit-documents"

# ---------------------------------------------------------------------------
# Web Push (VAPID) — PRD R-07
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
